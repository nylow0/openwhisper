{
  "name": "openwhisper",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "typecheck": "bun run --cwd apps/desktop typecheck",
    "test": "bun run --cwd apps/desktop test",
    "check": "bun run --cwd apps/desktop typecheck && cargo check --manifest-path crates/openwhisper-native/Cargo.toml && cargo test --manifest-path crates/openwhisper-asr-rs/Cargo.toml",
    "cargo:build": "cargo build --manifest-path crates/openwhisper-native/Cargo.toml",
    "cargo:dev": "cargo run --manifest-path crates/openwhisper-native/Cargo.toml",
    "asr:rust:test": "cargo test --manifest-path crates/openwhisper-asr-rs/Cargo.toml",
    "setup": "bun install && bun run install:electron && cargo fetch",
    "install:electron": "node scripts/install-electron.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
