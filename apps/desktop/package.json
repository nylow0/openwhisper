{
  "name": "@openwhisper/desktop",
  "version": "0.1.0",
  "description": "Windows-first offline dictation desktop app",
  "author": "Dany",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && bun run prepare:preload && vite build",
    "prepare:preload": "bun -e \"const fs = require('fs'); fs.copyFileSync('dist/main/preload.js', 'dist/main/preload.cjs');\"",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "electron:dev": "tsc && bun run prepare:preload && vite build && electron .",
    "electron:build": "tsc && bun run prepare:preload && vite build && electron-builder && bun run update:start-menu",
    "update:start-menu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-start-menu-shortcut.ps1"
  },
  "dependencies": {
    "flag-icons": "^7.5.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "svelte": "^4.0.0",
    "svelte-check": "^3.0.0",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vite": "^5.0.0"
  },
  "main": "dist/main/index.js",
  "build": {
    "appId": "com.openwhisper.desktop",
    "productName": "OpenWhisper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/shared/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
