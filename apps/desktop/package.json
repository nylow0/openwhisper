{
  "name": "@openwhisper/desktop",
  "version": "0.1.0",
  "description": "Windows-first offline dictation desktop app",
  "author": "Dany",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && bun run prepare:preload && vite build",
    "prepare:preload": "bun -e \"const fs = require('fs'); fs.copyFileSync('dist/main/preload.js', 'dist/main/preload.cjs');\"",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "electron:dev": "tsc && bun run prepare:preload && vite build && electron .",
    "native:release": "cargo build --manifest-path ../../crates/openwhisper-native/Cargo.toml --release --target x86_64-pc-windows-msvc && cargo build --manifest-path ../../crates/openwhisper-asr-rs/Cargo.toml --release --target x86_64-pc-windows-msvc",
    "package:smoke": "bun scripts/smoke-package.mjs",
    "electron:build": "bun run native:release && tsc && bun run prepare:preload && vite build && electron-builder && bun run package:smoke && bun run update:start-menu",
    "update:start-menu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-start-menu-shortcut.ps1"
  },
  "dependencies": {
    "flag-icons": "^7.5.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "svelte": "^4.0.0",
    "svelte-check": "^3.0.0",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vite": "^5.0.0"
  },
  "main": "dist/main/index.js",
  "build": {
    "appId": "com.openwhisper.desktop",
    "productName": "OpenWhisper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../crates/openwhisper-native/target/x86_64-pc-windows-msvc/release/openwhisper-native.exe",
        "to": "native/openwhisper-native.exe"
      },
      {
        "from": "../../crates/openwhisper-asr-rs/target/x86_64-pc-windows-msvc/release/ow-asr-rs.exe",
        "to": "native/ow-asr-rs.exe"
      },
      {
        "from": "../../config/whispercpp-profiles.json",
        "to": "config/whispercpp-profiles.json"
      },
      {
        "from": "../../models",
        "to": "models",
        "filter": [
          "ggml-medium.en-q8_0.bin",
          "ggml-large-v3-turbo-q8_0.bin"
        ]
      },
      {
        "from": "../../asr/.local/whispercpp-src/build-cpu-avxvnni-local/bin",
        "to": "whispercpp/cpu",
        "filter": [
          "whisper-cli.exe",
          "*.dll"
        ]
      },
      {
        "from": "../../asr/.local/whispercpp/cuda-bin/Release",
        "to": "whispercpp/gpu",
        "filter": [
          "whisper-cli.exe",
          "*.dll"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
